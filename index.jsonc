{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "gg_multi_commit",

  // 1-2 sentence summary about this repo.
  "summary": "Daily ticket flows of the gg_multi tool family: commit, push, review, upgrade deps across all ticket repos in dependency order.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "can/do/did commit, push, review; do upgrade deps; localized refs, #gg: commits",
    "gg do commit / gg do review: all messages and version increments on one sheet in the editor; --no-interactive",
    "do review: pull requests, didReview flag for gg do publish",
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {
      "gg_multi_core": "WorkspaceUtils, TicketState, TicketLocalizer, PublishPlanner",
      "gg_one": "per-repo commands: CanCommit, DoCommit, DoPush, DidCommit, CreatePullRequest, DoUpgradeDeps",
      "gg_one_core": "MessageSheet, CommitMessage, GgState, GgSystemCommit",
      "gg_local_package_dependencies": "SortedProcessingList: dependency order",
      "gg_changelog": "changelog of the commits",
      "gg_publish": "publish helpers",
      "gg_git": "git state, branches",
      "gg_lang": "language detection",
      "gg_args": "command base",
      "gg_status_printer": "progress output",
      "gg_console_colors": "colored output",
      "gg_log": "GgLog",
      "dna_ggsuite": "dev: DNA layer: guides, templates",
      "helix": "dev: runDnaTest",
    },

    // "<repo-b>": "why / API"
    "usedBy": {
      "gg_multi_do_publish": "DidCommitCommand, DoPushCommand in can publish / do publish",
      "gg_multi": "registers can/do/did commit, push, review, upgrade deps",
    },
  },
}
